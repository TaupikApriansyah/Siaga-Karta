APP_NAME="Siaga Karta"
APP_ENV=local
APP_KEY=
# Opsional saat rotasi APP_KEY bertahap. Pisahkan beberapa key lama dengan koma.
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Default development database. Aktifkan extension pdo_sqlite.
DB_CONNECTION=sqlite
# Untuk MySQL/MariaDB, ganti menjadi:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=siagakarta
# DB_USERNAME=siagakarta
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

AUTH_IDLE_MINUTES=60
AUTH_ABSOLUTE_HOURS=12
AUTH_REFRESH_WARNING_MINUTES=5
AUTH_MAX_ACTIVE_TOKENS=8
# Secret stabil untuk fingerprint NIK/telepon. Generate sekali, jangan ikut dirotasi bersama APP_KEY.
DATA_FINGERPRINT_KEY=
# Daftar proxy tepercaya dipisahkan koma. Jangan gunakan *.
TRUSTED_PROXIES=127.0.0.1,::1

# Gmail/SMTP untuk mengirim kode pelacakan kepada warga. Gunakan App Password, bukan password akun Gmail.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS="noreply@siagakarta.local"
MAIL_FROM_NAME="SIAGA KARTA"

VITE_APP_NAME="${APP_NAME}"

# Set 0 to disable SQL slow-query logging. Bindings are never logged.
SLOW_QUERY_MS=250

# Retensi notifikasi internal. Audit log tidak dipangkas otomatis.
READ_NOTIFICATION_RETENTION_DAYS=90
UNREAD_NOTIFICATION_RETENTION_DAYS=180

# Demo only. Jangan aktifkan credential tetap ini di production sungguhan.
DEMO_MODE=false
DEMO_PASSWORD=Rajawali21

# SIAGA KARTA - peta dan master wilayah Kota Bandung.
BANDUNG_KELURAHAN_GEOJSON_URL=https://github.com/tryfatur/geojson-bandung/raw/refs/heads/master/3273-kota-bandung-level-kelurahan.json
BANDUNG_REGION_API_BASE_URL=https://wilayah.id/api
