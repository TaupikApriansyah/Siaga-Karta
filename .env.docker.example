APP_NAME="Siaga Karta"
APP_ENV=production
# WAJIB generate sendiri: php artisan key:generate --show
APP_KEY=
# Opsional saat rotasi APP_KEY bertahap. Pisahkan beberapa key lama dengan koma.
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_URL=https://siagakarta.example.com
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=siagakarta
DB_USERNAME=siagakarta
# WAJIB gunakan secret unik yang panjang. Jangan commit nilai production.
DB_PASSWORD=GANTI_DENGAN_PASSWORD_DATABASE_YANG_KUAT
DB_ROOT_PASSWORD=GANTI_DENGAN_PASSWORD_ROOT_DATABASE_YANG_BERBEDA

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Token API: idle diperpanjang saat user aktif, tetapi tidak melewati batas absolut.
AUTH_IDLE_MINUTES=60
AUTH_ABSOLUTE_HOURS=12
AUTH_REFRESH_WARNING_MINUTES=5
AUTH_MAX_ACTIVE_TOKENS=8
# Secret stabil untuk fingerprint NIK/telepon. Generate sekali, jangan ikut dirotasi bersama APP_KEY.
DATA_FINGERPRINT_KEY=

# Jika memakai profile cloudflare pada docker-compose, gunakan IP container cloudflared ini.
# Jangan gunakan wildcard "*".
TRUSTED_PROXIES=172.29.0.30

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@siagakarta.local"
MAIL_FROM_NAME="${APP_NAME}"

APP_PORT=8080
CLOUDFLARE_TUNNEL_TOKEN=PASTE_TOKEN_TUNNEL_DI_SINI

# Set 0 to disable SQL slow-query logging. Bindings are never logged.
SLOW_QUERY_MS=500

# Retensi notifikasi internal. Audit log tidak dipangkas otomatis.
READ_NOTIFICATION_RETENTION_DAYS=90
UNREAD_NOTIFICATION_RETENTION_DAYS=180
